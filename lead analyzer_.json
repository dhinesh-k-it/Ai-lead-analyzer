    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO analytics_daily_summary (report_date, total_leads, hot_count, warm_count, cold_count, avg_score)\nSELECT\n  CURRENT_DATE,\n  COUNT(*),\n  COUNT(*) FILTER (WHERE lead_category = 'hot'),\n  COUNT(*) FILTER (WHERE lead_category = 'warm'),\n  COUNT(*) FILTER (WHERE lead_category = 'cold'),\n  AVG(lead_score)\nFROM leads_analytics\nWHERE received_at::date = CURRENT_DATE\nON CONFLICT (report_date) DO UPDATE SET\n  total_leads = EXCLUDED.total_leads,\n  hot_count = EXCLUDED.hot_count,\n  warm_count = EXCLUDED.warm_count,\n  cold_count = EXCLUDED.cold_count,\n  avg_score = EXCLUDED.avg_score;",
        "options": {}
      },
      "id": "6b781661-f4bc-432d-9b52-07825793aa70",
      "name": "Analytics - Update Daily Summary",
